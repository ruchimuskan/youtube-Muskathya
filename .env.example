# Application
APP_ENV=development
DATA_DIR=./data
OUTPUT_DIR=./output
LOG_DIR=./logs
TIMEZONE=Asia/Kolkata
EMERGENCY_STOP=false

# Database (SQLite default; set DATABASE_URL for PostgreSQL later)
DATABASE_URL=sqlite:///./data/channel_manager.db

# AI provider: cloudflare | ollama | auto
AI_PROVIDER=auto
AI_CLOUDFLARE_DAILY_LIMIT=9000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# Content defaults
DEFAULT_LANGUAGE=hi
DEFAULT_GENRE=moral
VIDEO_ASPECT_RATIO=16:9
VIDEO_MIN_DURATION_SEC=360
VIDEO_MAX_DURATION_SEC=600
MAX_DAILY_UPLOADS=1
PRIVACY_MODE=public
PUBLISHING_MODE=schedule
PUBLISH_HOUR=18
PUBLISH_MINUTE=0
PIPELINE_DAILY_RUN_HOUR=15
PIPELINE_DAILY_RUN_MINUTE=0
SHORTS_RATIO=0

# Piper TTS
PIPER_BIN=piper
PIPER_VOICES_DIR=./data/voices
PIPER_VOICE_HI_MALE=hi_IN-pratham-medium
PIPER_VOICE_HI_FEMALE=hi_IN-shreya-medium
PIPER_VOICE_EN_MALE=en_US-lessac-medium
PIPER_VOICE_EN_FEMALE=en_US-amy-medium

# ComfyUI (optional)
COMFYUI_URL=http://127.0.0.1:8188
IMAGE_FALLBACK_DIR=./data/fallback_images
COMFYUI_ENABLED=false

# FFmpeg
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Faster-Whisper (subtitle verification)
WHISPER_MODEL=base

# YouTube / Google OAuth (create in Google Cloud Console)
# Absolute path OK if filename has spaces, e.g. Desktop JSON from Google Cloud
GOOGLE_CLIENT_SECRETS_FILE=./client_secrets.json
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/oauth2/callback
YOUTUBE_OAUTH_TOKEN_FILE=./data/oauth_tokens.json
YOUTUBE_UPLOAD_CHUNK_SIZE=1048576

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# GitHub (for cron-job.org repository_dispatch — store in GitHub Secrets for CI)
# GITHUB_TOKEN=  # never commit
